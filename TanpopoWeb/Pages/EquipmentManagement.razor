@page "/equipment-management"
@using System.ComponentModel.DataAnnotations
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<h3>设备与生产线信息管理</h3>
<hr />

@if (equipments == null)
{
    <p>正在加载设备列表...</p>
}
else
{
    <div class="row">
        <div class="col-md-12">
            <div class="card mb-4">
                <div class="card-header bg-secondary text-white">
                    <h5>设备列表</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    @{
                                        string EquipmentCodeStr = "EquipmentCode";
										string NameStr = "Name";
										string TypeStr = "Type";
										string MaxCapacityStr = "MaxCapacity";
										string ParallelJobsStr = "ParallelJobs";
                                    }
                                    <th @onclick="() => SortEquipments(EquipmentCodeStr)">
                                        设备编码
                                        @GetSortIcon("EquipmentCode")
                                    </th>
                                    <th @onclick="() => SortEquipments(NameStr)">
                                        设备名称
                                        @GetSortIcon("Name")
                                    </th>
                                    <th @onclick="() => SortEquipments(TypeStr)">
                                        设备类型
                                        @GetSortIcon("Type")
                                    </th>
                                    <th @onclick="() => SortEquipments(MaxCapacityStr)">
                                        最大产能
                                        @GetSortIcon("MaxCapacity")
                                    </th>
                                    <th @onclick="() => SortEquipments(ParallelJobsStr)">
                                        并行作业能力
                                        @GetSortIcon("ParallelJobs")
                                    </th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in equipments)
                                {
                                    <tr @ondblclick="() => OpenEditModal(item)">
                                        <td>@item.EquipmentCode</td>
                                        <td>@item.Name</td>
                                        <td>@GetEquipmentTypeName(item.Type)</td>
                                        <td>@item.MaxCapacity 件/小时</td>
                                        <td>@item.ParallelJobs</td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="(() => OpenEditModal(item))">
                                                <i class="bi bi-pencil"></i> 编辑
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="(() => DeleteEquipment(item))">
                                                <i class="bi bi-trash"></i> 删除
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer">
                    <button class="btn btn-success" @onclick="OpenNewModal">
                        <i class="bi bi-plus"></i> 新建设备
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- 设备详细信息模态窗口 -->
<div class="modal fade" id="equipmentDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">@(selectedEquipment?.Name ?? "新建设备") - 详细信息</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @if (selectedEquipment != null)
                {
                    <form @onsubmit="SaveEquipment">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="EquipmentCode" class="form-label">设备编码</label>
                                    <input type="text" class="form-control" id="EquipmentCode" @bind="selectedEquipment.EquipmentCode" required />
                                </div>
                                <div class="mb-3">
                                    <label for="EquipmentName" class="form-label">设备名称</label>
                                    <input type="text" class="form-control" id="EquipmentName" @bind="selectedEquipment.Name" required />
                                </div>
                                <div class="mb-3">
                                    <label for="EquipmentType" class="form-label">设备类型</label>
                                    <select class="form-select" id="EquipmentType" @bind="selectedEquipment.Type">
                                        <option value="MachiningCenter">加工中心</option>
                                        <option value="TestingEquipment">检测设备</option>
                                        <option value="AssemblyLine">装配线</option>
                                        <option value="AutomationRobot">自动化机器人</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label for="MaxCapacity" class="form-label">最大产能 (件/小时)</label>
                                    <input type="number" class="form-control" id="MaxCapacity" @bind="selectedEquipment.MaxCapacity" min="1" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="ParallelJobs" class="form-label">并行作业能力</label>
                                    <input type="number" class="form-control" id="ParallelJobs" @bind="selectedEquipment.ParallelJobs" min="1" />
                                </div>
                                <div class="mb-3">
                                    <label for="AvailableTimeWindow" class="form-label">可用时间窗口</label>
                                    <input type="text" class="form-control" id="AvailableTimeWindow" @bind="selectedEquipment.AvailableTimeWindow" placeholder="例如: 周一至周五 08:00-20:00" />
                                </div>
                                <div class="mb-3">
                                    <label for="MaintenanceSchedule" class="form-label">维护计划</label>
                                    <input type="text" class="form-control" id="MaintenanceSchedule" @bind="selectedEquipment.MaintenanceSchedule" placeholder="例如: 每月第一周周一" />
                                </div>
                                <div class="mb-3">
                                    <label for="MTTR" class="form-label">平均修复时间 (小时)</label>
                                    <input type="number" class="form-control" id="MTTR" @bind="selectedEquipment.MTTR" min="0.1" step="0.1" />
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-12">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="IsActive" @bind="selectedEquipment.IsActive" />
                                    <label class="form-check-label" for="IsActive">
                                        设备是否启用
                                    </label>
                                </div>
                            </div>
                        </div>
                    </form>
                }
                else
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">加载中...</span>
                        </div>
                        <p class="mt-3">正在加载设备信息...</p>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary" @onclick="SaveEquipment">保存</button>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-success mt-3">
        @message
    </div>
}

@code {
    private List<EquipmentViewModel> equipments;
    private EquipmentViewModel selectedEquipment;
    private string currentSortColumn = "EquipmentCode";
    private SortDirection currentSortDirection = SortDirection.Ascending;
    private string message = string.Empty;
    private IJSObjectReference? modalModule;
    private BootstrapModal? modal;

    protected override async Task OnInitializedAsync()
    {
        await LoadEquipments();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            modalModule = await JSRuntime.InvokeAsync<IJSObjectReference>("bootstrap.Modal.getOrCreateInstance", "#equipmentDetailModal");
            modal = new BootstrapModal(modalModule);
        }
    }

    private async Task LoadEquipments()
    {
        // 模拟从数据库加载设备数据
        // 实际应用中应该调用服务或API来获取数据
        equipments = new List<EquipmentViewModel>
        {
            new EquipmentViewModel
            {
                Id = 1,
                EquipmentCode = "EQP-0001",
                Name = "高精度加工中心",
                Type = "MachiningCenter",
                MaxCapacity = 20,
                ParallelJobs = 2,
                AvailableTimeWindow = "周一至周五 08:00-20:00",
                MaintenanceSchedule = "每月第一周周一",
                MTTR = 2.5,
                IsActive = true
            },
            new EquipmentViewModel
            {
                Id = 2,
                EquipmentCode = "EQP-0002",
                Name = "自动化检测设备",
                Type = "TestingEquipment",
                MaxCapacity = 15,
                ParallelJobs = 1,
                AvailableTimeWindow = "周一至周六 08:00-18:00",
                MaintenanceSchedule = "每季度第一月第一周",
                MTTR = 1.0,
                IsActive = true
            },
            new EquipmentViewModel
            {
                Id = 3,
                EquipmentCode = "EQP-0003",
                Name = "装配生产线",
                Type = "AssemblyLine",
                MaxCapacity = 10,
                ParallelJobs = 4,
                AvailableTimeWindow = "周一至周五 08:00-17:00",
                MaintenanceSchedule = "每月最后一个周末",
                MTTR = 3.0,
                IsActive = true
            },
            new EquipmentViewModel
            {
                Id = 4,
                EquipmentCode = "EQP-0004",
                Name = "焊接机器人",
                Type = "AutomationRobot",
                MaxCapacity = 30,
                ParallelJobs = 1,
                AvailableTimeWindow = "周一至周六 08:00-22:00",
                MaintenanceSchedule = "每两周一次",
                MTTR = 1.5,
                IsActive = true
            }
        };

        // 默认排序
        SortEquipments(currentSortColumn);
        StateHasChanged();
    }

    private void SortEquipments(string column)
    {
        if (currentSortColumn == column)
        {
            currentSortDirection = currentSortDirection == SortDirection.Ascending
                ? SortDirection.Descending
                : SortDirection.Ascending;
        }
        else
        {
            currentSortColumn = column;
            currentSortDirection = SortDirection.Ascending;
        }

        switch (currentSortColumn)
        {
            case "EquipmentCode":
                equipments = currentSortDirection == SortDirection.Ascending
                    ? equipments.OrderBy(e => e.EquipmentCode).ToList()
                    : equipments.OrderByDescending(e => e.EquipmentCode).ToList();
                break;
            case "Name":
                equipments = currentSortDirection == SortDirection.Ascending
                    ? equipments.OrderBy(e => e.Name).ToList()
                    : equipments.OrderByDescending(e => e.Name).ToList();
                break;
            case "Type":
                equipments = currentSortDirection == SortDirection.Ascending
                    ? equipments.OrderBy(e => e.Type).ToList()
                    : equipments.OrderByDescending(e => e.Type).ToList();
                break;
            case "MaxCapacity":
                equipments = currentSortDirection == SortDirection.Ascending
                    ? equipments.OrderBy(e => e.MaxCapacity).ToList()
                    : equipments.OrderByDescending(e => e.MaxCapacity).ToList();
                break;
            case "ParallelJobs":
                equipments = currentSortDirection == SortDirection.Ascending
                    ? equipments.OrderBy(e => e.ParallelJobs).ToList()
                    : equipments.OrderByDescending(e => e.ParallelJobs).ToList();
                break;
        }

        StateHasChanged();
    }

    private string GetSortIcon(string column)
    {
        if (currentSortColumn != column)
            return "";

        return currentSortDirection == SortDirection.Ascending
            ? "↑"
            : "↓";
    }

    private string GetEquipmentTypeName(string equipmentType)
    {
        return equipmentType switch
        {
            "MachiningCenter" => "加工中心",
            "TestingEquipment" => "检测设备",
            "AssemblyLine" => "装配线",
            "AutomationRobot" => "自动化机器人",
            _ => equipmentType
        };
    }

    private void OpenEditModal(EquipmentViewModel equipment)
    {
        selectedEquipment = (EquipmentViewModel)equipment.Clone();
        modal?.Show();
    }

    private void OpenNewModal()
    {
        selectedEquipment = new EquipmentViewModel
        {
            EquipmentCode = "NEW-EQXXXX",
            Name = "新建设备",
            IsActive = true
        };
        modal?.Show();
    }

    private void DeleteEquipment(EquipmentViewModel equipment)
    {
        equipments.Remove(equipment);
        message = $"设备 {equipment.Name} 已删除";

        // 3秒后清空消息
        Task.Delay(3000).ContinueWith(t => InvokeAsync(() => message = ""));
    }

    private async Task SaveEquipment()
    {
        // 验证表单
        if (selectedEquipment.MaxCapacity <= 0)
        {
            message = "最大产能必须大于0";
            return;
        }

        if (selectedEquipment.ParallelJobs <= 0)
        {
            message = "并行作业能力必须大于0";
            return;
        }

        // 模拟保存设备数据
        // 实际应用中应该调用服务或API来保存数据

        // 如果是新建设备，添加到列表
        if (selectedEquipment.Id == 0)
        {
            selectedEquipment.Id = equipments.Any() ? equipments.Max(e => e.Id) + 1 : 1;
            equipments.Add(selectedEquipment);
            message = $"设备 {selectedEquipment.Name} 已创建";
        }
        else
        {
            // 更新现有设备
            var originalEquipment = equipments.First(e => e.Id == selectedEquipment.Id);
            originalEquipment.EquipmentCode = selectedEquipment.EquipmentCode;
            originalEquipment.Name = selectedEquipment.Name;
            originalEquipment.Type = selectedEquipment.Type;
            originalEquipment.MaxCapacity = selectedEquipment.MaxCapacity;
            originalEquipment.ParallelJobs = selectedEquipment.ParallelJobs;
            originalEquipment.AvailableTimeWindow = selectedEquipment.AvailableTimeWindow;
            originalEquipment.MaintenanceSchedule = selectedEquipment.MaintenanceSchedule;
            originalEquipment.MTTR = selectedEquipment.MTTR;
            originalEquipment.IsActive = selectedEquipment.IsActive;

            message = $"设备 {selectedEquipment.Name} 已更新";
        }

        // 重新排序列表
        SortEquipments(currentSortColumn);

        // 关闭模态窗口
        modal?.Hide();

        // 3秒后清空消息
        await Task.Delay(3000);
        message = "";
    }

    public enum SortDirection
    {
        Ascending,
        Descending
    }

    public class EquipmentViewModel : ICloneable
    {
        public int Id { get; set; }

        [Required]
        public string EquipmentCode { get; set; }

        [Required]
        public string Name { get; set; }

        public string Type { get; set; }

        public int MaxCapacity { get; set; }

        public int ParallelJobs { get; set; }

        public string AvailableTimeWindow { get; set; }

        public string MaintenanceSchedule { get; set; }

        public double MTTR { get; set; }

        public bool IsActive { get; set; } = true;

        public object Clone()
        {
            return new EquipmentViewModel
            {
                Id = Id,
                EquipmentCode = EquipmentCode,
                Name = Name,
                Type = Type,
                MaxCapacity = MaxCapacity,
                ParallelJobs = ParallelJobs,
                AvailableTimeWindow = AvailableTimeWindow,
                MaintenanceSchedule = MaintenanceSchedule,
                MTTR = MTTR,
                IsActive = IsActive
            };
        }
    }

    public class BootstrapModal
    {
        private readonly IJSObjectReference _modal;

        public BootstrapModal(IJSObjectReference modal)
        {
            _modal = modal;
        }

        public async Task Show()
        {
            await _modal.InvokeVoidAsync("show");
        }

        public async Task Hide()
        {
            await _modal.InvokeVoidAsync("hide");
        }

        public async ValueTask DisposeAsync()
        {
            if (_modal != null)
            {
                await _modal.DisposeAsync();
            }
        }
    }
}