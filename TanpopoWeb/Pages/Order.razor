@page "/order-management"
@using System.ComponentModel.DataAnnotations
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<h3>订单管理</h3>
<hr />

@if (orders == null)
{
    <p>正在加载订单列表...</p>
}
else
{
    <div class="row">
        <div class="col-md-12">
            <div class="card mb-4">
                <div class="card-header bg-secondary text-white">
                    <h5>订单列表</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th @onclick="() => SortOrders(nameof(OrderViewModel.OrderNumber))">
                                        订单号
                                        @GetSortIcon(nameof(OrderViewModel.OrderNumber))
                                    </th>
                                    <th @onclick="() => SortOrders(nameof(OrderViewModel.CustomerName))">
                                        客户名称
                                        @GetSortIcon(nameof(OrderViewModel.CustomerName))
                                    </th>
                                    <th @onclick="() => SortOrders(nameof(OrderViewModel.ProductName))">
                                        需求产品
                                        @GetSortIcon(nameof(OrderViewModel.ProductName))
                                    </th>
                                    <th @onclick="() => SortOrders(nameof(OrderViewModel.Quantity))">
                                        数量
                                        @GetSortIcon(nameof(OrderViewModel.Quantity))
                                    </th>
                                    <th @onclick="() => SortOrders(nameof(OrderViewModel.Priority))">
                                        优先级
                                        @GetSortIcon(nameof(OrderViewModel.Priority))
                                    </th>
                                    <th @onclick="() => SortOrders(nameof(OrderViewModel.OrderType))">
                                        订单类型
                                        @GetSortIcon(nameof(OrderViewModel.OrderType))
                                    </th>
                                    <th @onclick="() => SortOrders(nameof(OrderViewModel.PromisedDeliveryDate))">
                                        承诺交货日期
                                        @GetSortIcon(nameof(OrderViewModel.PromisedDeliveryDate))
                                    </th>
                                    <th @onclick="() => SortOrders(nameof(OrderViewModel.LatestAcceptableDate))">
                                        最晚可接受日期
                                        @GetSortIcon(nameof(OrderViewModel.LatestAcceptableDate))
                                    </th>
                                    <th @onclick="() => SortOrders(nameof(OrderViewModel.AllowSplitDelivery))">
                                        是否允许分批交付
                                        @GetSortIcon(nameof(OrderViewModel.AllowSplitDelivery))
                                    </th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in orders)
                                {
                                    <tr @ondblclick="() => OpenEditOrderModal(item)">
                                        <td>@item.OrderNumber</td>
                                        <td>@item.CustomerName</td>
                                        <td>@item.ProductName</td>
                                        <td>@item.Quantity</td>
                                        <td>@GetPriorityName(item.Priority)</td>
                                        <td>@GetOrderTypeName(item.OrderType)</td>
                                        <td>@item.PromisedDeliveryDate?.ToString("yyyy-MM-dd")</td>
                                        <td>@item.LatestAcceptableDate?.ToString("yyyy-MM-dd")</td>
                                        <td>@(item.AllowSplitDelivery ? "是" : "否")</td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="(() => OpenEditOrderModal(item))">
                                                <i class="bi bi-pencil"></i> 编辑
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="(() => DeleteOrder(item))">
                                                <i class="bi bi-trash"></i> 删除
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer">
                    <button class="btn btn-success" @onclick="OpenNewOrderModal">
                        <i class="bi bi-plus"></i> 新建订单
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- 订单详细信息模态窗口 -->
<div class="modal fade" id="orderDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">@(selectedOrder?.OrderNumber ?? "新建订单") - 详细信息</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @if (selectedOrder != null)
                {
                    <form @onsubmit="SaveOrder">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="OrderNumber" class="form-label">订单号</label>
                                    <input type="text" class="form-control" id="OrderNumber" @bind="selectedOrder.OrderNumber" required />
                                </div>
                                <div class="mb-3">
                                    <label for="CustomerName" class="form-label">客户名称</label>
                                    <input type="text" class="form-control" id="CustomerName" @bind="selectedOrder.CustomerName" required />
                                </div>
                                <div class="mb-3">
                                    <label for="ProductName" class="form-label">需求产品</label>
                                    <input type="text" class="form-control" id="ProductName" @bind="selectedOrder.ProductName" required />
                                </div>
                                <div class="mb-3">
                                    <label for="Quantity" class="form-label">数量</label>
                                    <input type="number" class="form-control" id="Quantity" @bind="selectedOrder.Quantity" min="1" required />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="Priority" class="form-label">订单优先级</label>
                                    <select class="form-select" id="Priority" @bind="selectedOrder.Priority">
                                        <option value="@OrderPriority.Normal">常规</option>
                                        <option value="@OrderPriority.Urgent">紧急</option>
                                        <option value="@OrderPriority.VIP">VIP客户</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label for="OrderType" class="form-label">订单类型</label>
                                    <select class="form-select" id="OrderType" @bind="selectedOrder.OrderType">
                                        <option value="@OrderType.Normal">正常订单</option>
                                        <option value="@OrderType.Development">开发订单</option>
                                        <option value="@OrderType.InventoryPreparation">备货订单</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label for="PromisedDeliveryDate" class="form-label">承诺交货日期</label>
                                    <input type="date" class="form-control" id="PromisedDeliveryDate" @bind="selectedOrder.PromisedDeliveryDate" required />
                                </div>
                                <div class="mb-3">
                                    <label for="LatestAcceptableDate" class="form-label">最晚可接受日期</label>
                                    <input type="date" class="form-control" id="LatestAcceptableDate" @bind="selectedOrder.LatestAcceptableDate" required />
                                </div>
                                <div class="mb-3">
                                    <label for="AllowSplitDelivery" class="form-label">是否允许分批交付</label>
                                    <select class="form-select" id="AllowSplitDelivery" @bind="selectedOrder.AllowSplitDelivery">
                                        <option value="true">是</option>
                                        <option value="false">否</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </form>
                }
                else
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">加载中...</span>
                        </div>
                        <p class="mt-3">正在加载订单信息...</p>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary" @onclick="SaveOrder">保存</button>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-success mt-3">
        @message
    </div>
}

@code {
    private List<OrderViewModel> orders;
    private OrderViewModel selectedOrder;
    private string currentSortColumn = nameof(OrderViewModel.OrderNumber);
    private SortDirection currentSortDirection = SortDirection.Ascending;
    private string message = string.Empty;
    private IJSObjectReference? modalModule;
    private BootstrapModal? modal;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            modalModule = await JSRuntime.InvokeAsync<IJSObjectReference>("bootstrap.Modal.getOrCreateInstance", "#orderDetailModal");
            modal = new BootstrapModal(modalModule);
        }
    }

    private async Task LoadOrders()
    {
        // 模拟从数据库加载订单数据
        orders = new List<OrderViewModel>
        {
            new OrderViewModel
            {
                OrderNumber = "ORD-2025-0001",
                CustomerName = "ABC科技有限公司",
                ProductName = "高性能电机",
                Quantity = 100,
                Priority = OrderPriority.Normal,
                OrderType = OrderType.Normal,
                PromisedDeliveryDate = DateTime.Parse("2025-05-31"),
                LatestAcceptableDate = DateTime.Parse("2025-06-10"),
                AllowSplitDelivery = false
            },
            new OrderViewModel
            {
                OrderNumber = "ORD-2025-0002",
                CustomerName = "DEF电子有限公司",
                ProductName = "定制控制器",
                Quantity = 50,
                Priority = OrderPriority.Urgent,
                OrderType = OrderType.Development,
                PromisedDeliveryDate = DateTime.Parse("2025-05-20"),
                LatestAcceptableDate = DateTime.Parse("2025-05-30"),
                AllowSplitDelivery = true
            },
            new OrderViewModel
            {
                OrderNumber = "ORD-2025-0003",
                CustomerName = "VIP客户集团",
                ProductName = "铝制外壳",
                Quantity = 200,
                Priority = OrderPriority.VIP,
                OrderType = OrderType.InventoryPreparation,
                PromisedDeliveryDate = DateTime.Parse("2025-06-15"),
                LatestAcceptableDate = DateTime.Parse("2025-06-25"),
                AllowSplitDelivery = true
            }
        };

        // 默认排序
        SortOrders(currentSortColumn);
        StateHasChanged();
    }

    private void SortOrders(string column)
    {
        if (currentSortColumn == column)
        {
            currentSortDirection = currentSortDirection == SortDirection.Ascending
                ? SortDirection.Descending
                : SortDirection.Ascending;
        }
        else
        {
            currentSortColumn = column;
            currentSortDirection = SortDirection.Ascending;
        }

        switch (currentSortColumn)
        {
            case nameof(OrderViewModel.OrderNumber):
                orders = currentSortDirection == SortDirection.Ascending
                    ? orders.OrderBy(o => o.OrderNumber).ToList()
                    : orders.OrderByDescending(o => o.OrderNumber).ToList();
                break;
            case nameof(OrderViewModel.CustomerName):
                orders = currentSortDirection == SortDirection.Ascending
                    ? orders.OrderBy(o => o.CustomerName).ToList()
                    : orders.OrderByDescending(o => o.CustomerName).ToList();
                break;
            case nameof(OrderViewModel.ProductName):
                orders = currentSortDirection == SortDirection.Ascending
                    ? orders.OrderBy(o => o.ProductName).ToList()
                    : orders.OrderByDescending(o => o.ProductName).ToList();
                break;
            case nameof(OrderViewModel.Quantity):
                orders = currentSortDirection == SortDirection.Ascending
                    ? orders.OrderBy(o => o.Quantity).ToList()
                    : orders.OrderByDescending(o => o.Quantity).ToList();
                break;
            case nameof(OrderViewModel.Priority):
                orders = currentSortDirection == SortDirection.Ascending
                    ? orders.OrderBy(o => o.Priority).ToList()
                    : orders.OrderByDescending(o => o.Priority).ToList();
                break;
            case nameof(OrderViewModel.OrderType):
                orders = currentSortDirection == SortDirection.Ascending
                    ? orders.OrderBy(o => o.OrderType).ToList()
                    : orders.OrderByDescending(o => o.OrderType).ToList();
                break;
            case nameof(OrderViewModel.PromisedDeliveryDate):
                orders = currentSortDirection == SortDirection.Ascending
                    ? orders.OrderBy(o => o.PromisedDeliveryDate).ToList()
                    : orders.OrderByDescending(o => o.PromisedDeliveryDate).ToList();
                break;
            case nameof(OrderViewModel.LatestAcceptableDate):
                orders = currentSortDirection == SortDirection.Ascending
                    ? orders.OrderBy(o => o.LatestAcceptableDate).ToList()
                    : orders.OrderByDescending(o => o.LatestAcceptableDate).ToList();
                break;
            case nameof(OrderViewModel.AllowSplitDelivery):
                orders = currentSortDirection == SortDirection.Ascending
                    ? orders.OrderBy(o => o.AllowSplitDelivery).ToList()
                    : orders.OrderByDescending(o => o.AllowSplitDelivery).ToList();
                break;
        }

        StateHasChanged();
    }

    private string GetSortIcon(string column)
    {
        if (currentSortColumn != column)
            return "";

        return currentSortDirection == SortDirection.Ascending
            ? "↑"
            : "↓";
    }

    private string GetPriorityName(OrderPriority priority)
    {
        return priority switch
        {
            OrderPriority.Normal => "常规",
            OrderPriority.Urgent => "紧急",
            OrderPriority.VIP => "VIP客户",
            _ => priority.ToString()
        };
    }

    private string GetOrderTypeName(OrderType orderType)
    {
        return orderType switch
        {
            OrderType.Normal => "正常订单",
            OrderType.Development => "开发订单",
            OrderType.InventoryPreparation => "备货订单",
            _ => orderType.ToString()
        };
    }

    private void OpenEditOrderModal(OrderViewModel order)
    {
        selectedOrder = (OrderViewModel)order.Clone();
        modal?.Show();
    }

    private void OpenNewOrderModal()
    {
        selectedOrder = new OrderViewModel
            {
                OrderNumber = "NEW-XXXX",
                CustomerName = "新客户",
                ProductName = "新产品",
                Quantity = 1,
                Priority = OrderPriority.Normal,
                OrderType = OrderType.Normal,
                AllowSplitDelivery = false,
                PromisedDeliveryDate = DateTime.Now.AddDays(14),
                LatestAcceptableDate = DateTime.Now.AddDays(21)
            };
        modal?.Show();
    }

    private void DeleteOrder(OrderViewModel order)
    {
        orders.Remove(order);
        message = $"订单 {order.OrderNumber} 已删除";

        // 3秒后清空消息
        Task.Delay(3000).ContinueWith(t => InvokeAsync(() => message = ""));
    }

    private async Task SaveOrder()
    {
        // 验证表单
        if (selectedOrder == null)
        {
            message = "订单数据不完整";
            return;
        }

        if (selectedOrder.PromisedDeliveryDate > selectedOrder.LatestAcceptableDate)
        {
            message = "承诺交货日期不能晚于最晚可接受日期";
            return;
        }

        if (selectedOrder.Quantity <= 0)
        {
            message = "订单数量必须大于0";
            return;
        }

        // 模拟保存订单数据
        // 实际应用中应该调用服务或API来保存数据

        // 如果是新建订单，添加到列表
        if (string.IsNullOrEmpty(selectedOrder.OrderNumber) || selectedOrder.OrderNumber.StartsWith("NEW-"))
        {
            // 生成新的订单号
            var newOrderNumber = $"ORD-{DateTime.Now:yyyy}-{orders.Count + 1:D4}";
            selectedOrder.OrderNumber = newOrderNumber;
            orders.Add(selectedOrder);
            message = $"订单 {newOrderNumber} 已创建";
        }
        else
        {
            // 更新现有订单
            var originalOrder = orders.First(o => o.OrderNumber == selectedOrder.OrderNumber);
            originalOrder.CustomerName = selectedOrder.CustomerName;
            originalOrder.ProductName = selectedOrder.ProductName;
            originalOrder.Quantity = selectedOrder.Quantity;
            originalOrder.Priority = selectedOrder.Priority;
            originalOrder.OrderType = selectedOrder.OrderType;
            originalOrder.PromisedDeliveryDate = selectedOrder.PromisedDeliveryDate;
            originalOrder.LatestAcceptableDate = selectedOrder.LatestAcceptableDate;
            originalOrder.AllowSplitDelivery = selectedOrder.AllowSplitDelivery;

            message = $"订单 {selectedOrder.OrderNumber} 已更新";
        }

        // 重新排序列表
        SortOrders(currentSortColumn);

        // 关闭模态窗口
        modal?.Hide();

        // 3秒后清空消息
        await Task.Delay(3000);
        message = "";
    }

    public enum SortDirection
    {
        Ascending,
        Descending
    }

    public enum OrderPriority
    {
        Normal,
        Urgent,
        VIP
    }

    public enum OrderType
    {
        Normal,
        Development,
        InventoryPreparation
    }

    public class OrderViewModel : ICloneable
    {
        public string OrderNumber { get; set; } = string.Empty;
        public string CustomerName { get; set; } = string.Empty;
        public string ProductName { get; set; } = string.Empty;
        public int Quantity { get; set; }
        public OrderPriority Priority { get; set; }
        public OrderType OrderType { get; set; }
        public DateTime? PromisedDeliveryDate { get; set; }
        public DateTime? LatestAcceptableDate { get; set; }
        public bool AllowSplitDelivery { get; set; }

        public object Clone()
        {
            return new OrderViewModel
                {
                    OrderNumber = OrderNumber,
                    CustomerName = CustomerName,
                    ProductName = ProductName,
                    Quantity = Quantity,
                    Priority = Priority,
                    OrderType = OrderType,
                    PromisedDeliveryDate = PromisedDeliveryDate,
                    LatestAcceptableDate = LatestAcceptableDate,
                    AllowSplitDelivery = AllowSplitDelivery
                };
        }
    }

    public class BootstrapModal
    {
        private readonly IJSObjectReference _modal;

        public BootstrapModal(IJSObjectReference modal)
        {
            _modal = modal;
        }

        public async Task Show()
        {
            await _modal.InvokeVoidAsync("show");
        }

        public async Task Hide()
        {
            await _modal.InvokeVoidAsync("hide");
        }

        public async ValueTask DisposeAsync()
        {
            if (_modal != null)
            {
                await _modal.DisposeAsync();
            }
        }
    }
}